#!/usr/bin/env python3
"""Tiny local web server for the kiosk. Binds to 127.0.0.1 only."""
import http.server
import json
import os

APPS = os.environ.get("KIDOS_APPS", "/opt/kidos/apps")
STATE = os.environ.get("KIDOS_STATE", "/var/lib/kidos")
RUN = os.environ.get("KIDOS_RUN", "/run/kidos")
PORT = int(os.environ.get("KIDOS_PORT", "8777"))
HOSTS = {f"127.0.0.1:{PORT}", f"localhost:{PORT}"}


def version():
    try:
        with open(os.path.join(STATE, "version")) as f:
            return f.read().strip()[:12]
    except OSError:
        return "unknown"


class Handler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *a, **k):
        super().__init__(*a, directory=APPS, **k)

    def end_headers(self):
        self.send_header("Cache-Control", "no-store")
        super().end_headers()

    def _json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.split("?")[0] == "/version.json":
            return self._json(200, {"version": version()})
        return super().do_GET()

    def do_POST(self):
        if self.path == "/api/parent" and self.headers.get("Host") in HOSTS:
            # The kiosk session watches for this file, exits, and getty then
            # shows a normal login prompt instead of auto-logging in the kid.
            try:
                with open(os.path.join(RUN, "parent-mode"), "w") as f:
                    f.write("1\n")
            except OSError:
                return self._json(500, {"ok": False})
            return self._json(200, {"ok": True})
        return self._json(404, {"ok": False})

    def log_message(self, *args):
        pass


if __name__ == "__main__":
    http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
