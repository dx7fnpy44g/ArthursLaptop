#!/usr/bin/env bash
# Runs INSIDE the cage compositor. Keeps the kiosk browser alive.
set -u
URL="http://127.0.0.1:8777/"
FLAG="${KIDOS_RUN:-/run/kidos}/parent-mode"

# Keep volume toddler-safe (hard cap 70%, start at 50%).
wpctl set-volume -l 0.7 @DEFAULT_AUDIO_SINK@ 0.5 >/dev/null 2>&1 || true

# Wait (briefly) for the local app server.
for _ in $(seq 1 30); do curl -fs "$URL" >/dev/null 2>&1 && break; sleep 1; done

# If a grown-up asked for parent mode, stop the compositor so getty can show a login.
(
  while sleep 1; do
    if [ -e "$FLAG" ]; then pkill -TERM -u "$(id -u)" -x cage; break; fi
  done
) &

extra=()
[ -n "${KIDOS_SOFTWARE:-}" ] && extra+=(--disable-gpu)   # software-rendering fallback

while true; do
  profile="$(mktemp -d /tmp/kidos-chromium.XXXXXX)"
  chromium \
    --kiosk --start-fullscreen \
    --user-data-dir="$profile" \
    --ozone-platform=wayland \
    --no-first-run --no-default-browser-check --noerrdialogs --disable-infobars \
    --disable-session-crashed-bubble --disable-translate --disable-pinch \
    --overscroll-history-navigation=0 --password-store=basic \
    --autoplay-policy=no-user-gesture-required \
    --check-for-update-interval=31536000 \
    "${extra[@]}" \
    "$URL"
  rm -rf "$profile"
  sleep 1   # Ctrl+W etc. close the browser; just start it again
done
